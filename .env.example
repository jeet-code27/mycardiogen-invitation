# Admin console login (/admin)
ADMIN_USERNAME=cardiogen-admin
ADMIN_PASSWORD=choose-a-strong-password
# Random string used to sign the admin session cookie (e.g. `openssl rand -base64 32`)
SESSION_SECRET=

# Storage. On Vercel, connect an Upstash Redis database from the Storage tab and these are set for you.
# Locally they can be left empty; data is saved to .data/db.json instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=
